# ============================================================
#  Äura Fragancias — Variables de entorno
#  Copiá este archivo como ".env" y completá los valores.
#  IMPORTANTE: TODAS van también en Coolify -> aplicación -> Environment Variables
#  (las NEXT_PUBLIC_* marcadas como variables de build).
#  Las NEXT_PUBLIC_* son públicas por diseño (van al navegador).
#  META_CAPI_TOKEN es SECRETO: nunca le pongas NEXT_PUBLIC_.
# ============================================================

# --- Supabase (datos, login del panel y fotos; propio, en el servidor) ---
# URL pública de la API y clave "anon" (pública por diseño: la seguridad la dan las políticas RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo runtime del servidor: API por la red privada de Docker, sin salir al túnel.
SUPABASE_INTERNAL_URL=
# SECRETAS (solo servidor, nunca con NEXT_PUBLIC_):
# Secreto con el que se firman las sesiones: el servidor verifica con él que quien llama a /api/admin es admin.
SUPABASE_JWT_SECRET=
# Clave de servicio de Supabase (service_role): la usa SOLO el servidor para crear usuarios del panel, darles una
# contraseña nueva y quitarles el acceso (Configuración → Usuarios, vía GoTrue). Nunca con NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a Postgres con el usuario aura_server (supabase/migrations/003_usuario_servidor.sql).
# En Coolify el host es el contenedor de la base: supabase-db-<uuid del servicio>:5432
DATABASE_URL=

# --- Meta Ads (Pixel + Conversions API) ---
# Pixel activo de Aura: 1238570975103624 (ya viene por defecto en el codigo)
NEXT_PUBLIC_META_PIXEL_ID=1238570975103624
# Token de la Conversions API (Events Manager -> Conversions API -> Generar token).
# SECRETO - sin NEXT_PUBLIC. Rotalo si lo expones.
META_CAPI_TOKEN=
# Opcional: codigo de Test Events mientras validas.
META_TEST_EVENT_CODE=

# --- Google (GA4 + Google Ads) ---
# GA4: Admin -> Flujos de datos -> ID de medicion (empieza con G-)
NEXT_PUBLIC_GA4_ID=G-W3S7RJVZY7
# Google Ads: ID de conversion (empieza con AW-)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Etiqueta de la conversion "click a WhatsApp" (lo que va despues de la barra
# en send_to: AW-XXXX/estaParte). Conversion tipo Contacto/Lead.
NEXT_PUBLIC_GADS_WA_LABEL=

# --- TikTok Ads ---
# Public pixel code from Äura's TikTok Events Manager (not an access token).
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Pagopar (pago con tarjeta) ---
# La cuenta de comercio de Pagopar es la de albastore.lat y sus tokens viven
# SOLO ahí. Äura le pide al hub de ALBA (https://albastore.lat/api/pagopar/hub)
# que cree y consulte las transacciones, autenticándose con este secreto
# compartido (el mismo valor que PAGOPAR_HUB_SECRET en el Vercel de ALBA).
PAGOPAR_HUB_SECRET=
# Opcional: otra URL del hub (por defecto la de ALBA).
PAGOPAR_HUB_URL=
# Muestra la opción "Tarjeta" en el checkout (se compila en el build).
NEXT_PUBLIC_PAGOPAR_ENABLED=
