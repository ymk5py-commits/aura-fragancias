rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo: lectura pública, escritura solo admin autenticado.
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Configuración del sitio: lectura pública, escritura solo admin.
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Pedidos de la tienda.
    // - create: público (el cliente confirma su compra sin estar logueado),
    //   pero validado para evitar basura: campos obligatorios, importes
    //   numéricos y estado inicial forzado a "pendiente".
    // - read/update/delete: solo el admin autenticado.
    match /orders/{id} {
      allow read, update, delete: if request.auth != null;
      allow create: if
        request.resource.data.status == 'pendiente'
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 3
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 40
        && request.resource.data.address is string
        && request.resource.data.address.size() < 400
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50;
    }
  }
}
