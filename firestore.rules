rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo: lectura pública, escritura solo admin autenticado.
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Configuración del sitio: lectura pública, escritura solo admin.
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Pedidos de la tienda.
    // - create: público (el cliente confirma su compra sin estar logueado),
    //   pero validado para evitar basura: campos obligatorios, importes
    //   numéricos y estado inicial forzado a "pendiente".
    // - read/update/delete: solo el admin autenticado.
    match /orders/{id} {
      allow read, update, delete: if request.auth != null;
      allow create: if
        request.resource.data.status == 'pendiente'
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 3
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 40
        && request.resource.data.address is string
        && request.resource.data.address.size() < 400
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50;
    }

    // Reseñas de clientes.
    // - create: público, queda pendiente (approved=false) con campos validados.
    // - read: cualquiera lee las aprobadas; el admin lee todas.
    // - update/delete (aprobar, ocultar, borrar): solo admin.
    match /reviews/{id} {
      allow get, list: if resource.data.approved == true || request.auth != null;
      allow create: if request.auth != null || (
        request.resource.data.approved == false
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 40
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 600
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt is int
      );
      allow update, delete: if request.auth != null;
    }
  }
}
