rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Gift Cards privadas: emisión desde un pedido confirmado; importe y vigencia
    // inmutables. Cada disminución de saldo exige un movimiento de canje atómico.
    function validGiftCard(d) {
      return d.keys().hasAll(['code', 'orderId', 'orderCode', 'customer', 'phone', 'amount', 'balance', 'activatedAt', 'expiresAt', 'status', 'recipient', 'sender', 'message', 'lineIndex', 'copyIndex'])
        && d.keys().hasOnly(['code', 'orderId', 'orderCode', 'customer', 'phone', 'amount', 'balance', 'activatedAt', 'expiresAt', 'status', 'recipient', 'sender', 'message', 'lineIndex', 'copyIndex', 'lastRedemptionId'])
        && d.code is string && d.code.matches('^AURA-[A-F0-9]{32}$')
        && d.orderId is string && d.orderId.size() <= 100
        && d.orderCode is string && d.orderCode.matches('^AURA-[A-Z0-9]{4,20}$')
        && d.customer is string && d.customer.size() <= 120
        && d.phone is string && d.phone.size() <= 40
        && d.recipient is string && d.recipient.size() <= 80
        && d.sender is string && d.sender.size() <= 80
        && d.message is string && d.message.size() <= 300
        && d.amount is int && d.amount >= 100000 && d.amount <= 50000000
        && d.balance is int && d.balance >= 0 && d.balance <= d.amount
        && d.activatedAt is int && d.expiresAt is int
        && d.expiresAt == d.activatedAt + 5184000000
        && d.status in ['activa', 'agotada', 'anulada']
        && (d.status != 'activa' || d.balance > 0)
        && (d.status != 'agotada' || d.balance == 0)
        && d.lineIndex is int && d.lineIndex >= 0 && d.lineIndex < 50
        && d.copyIndex is int && d.copyIndex >= 0 && d.copyIndex < 50;
    }

    function giftCardPaidOrder(d) {
      let order = getAfter(/databases/$(database)/documents/orders/$(d.orderId)).data;
      let claim = getAfter(/databases/$(database)/documents/giftCardPayments/$(d.orderCode)).data;
      return order.status == 'confirmado' && order.orderId == d.orderCode
        && claim.orderId == d.orderId && claim.activatedAt == d.activatedAt
        && order.items[d.lineIndex].code == 'GIFT-CARD'
        && order.items[d.lineIndex].price == d.amount
        && order.items[d.lineIndex].quantity > d.copyIndex;
    }

    match /giftCardPayments/{code} {
      allow read: if isCashAdmin();
      allow create: if isCashAdmin()
        && request.resource.data.keys().hasOnly(['orderId', 'orderCode', 'amount', 'activatedAt'])
        && request.resource.data.orderId is string
        && request.resource.data.orderCode == code
        && request.resource.data.activatedAt is int
        && request.resource.data.amount is int && request.resource.data.amount >= 100000
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'confirmado'
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.orderId == code
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.total == request.resource.data.amount;
      allow update, delete: if false;
    }

    match /giftCards/{id} {
      allow read: if isCashAdmin();
      allow create: if isCashAdmin() && validGiftCard(request.resource.data)
        && request.resource.data.balance == request.resource.data.amount
        && request.resource.data.status == 'activa'
        && id == request.resource.data.orderId + '_' + string(request.resource.data.lineIndex) + '_' + string(request.resource.data.copyIndex)
        && giftCardPaidOrder(request.resource.data);
      allow update: if isCashAdmin() && validGiftCard(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'status', 'lastRedemptionId'])
        && (
          (request.resource.data.balance == resource.data.balance && request.resource.data.status == 'anulada' && resource.data.balance == resource.data.amount)
          || (resource.data.status == 'activa' && request.time.toMillis() < resource.data.expiresAt
            && request.resource.data.balance < resource.data.balance
            && request.resource.data.lastRedemptionId != resource.data.get('lastRedemptionId', '')
            && getAfter(/databases/$(database)/documents/giftCardRedemptions/$(request.resource.data.lastRedemptionId)).data.giftCardId == id
            && getAfter(/databases/$(database)/documents/giftCardRedemptions/$(request.resource.data.lastRedemptionId)).data.balanceBefore == resource.data.balance
            && getAfter(/databases/$(database)/documents/giftCardRedemptions/$(request.resource.data.lastRedemptionId)).data.balanceAfter == request.resource.data.balance)
        );
      allow delete: if false;
    }

    match /giftCardRedemptions/{id} {
      allow read: if isCashAdmin();
      allow create: if isCashAdmin()
        && request.resource.data.keys().hasOnly(['giftCardId', 'amount', 'balanceBefore', 'balanceAfter', 'reference', 'createdAt'])
        && request.resource.data.giftCardId is string
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && request.resource.data.balanceBefore is int && request.resource.data.balanceAfter is int && request.resource.data.balanceAfter >= 0
        && request.resource.data.balanceBefore - request.resource.data.amount == request.resource.data.balanceAfter
        && request.resource.data.reference is string && request.resource.data.reference.size() > 0 && request.resource.data.reference.size() <= 200
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/giftCards/$(request.resource.data.giftCardId)).data.balance == request.resource.data.balanceBefore
        && getAfter(/databases/$(database)/documents/giftCards/$(request.resource.data.giftCardId)).data.balance == request.resource.data.balanceAfter
        && getAfter(/databases/$(database)/documents/giftCards/$(request.resource.data.giftCardId)).data.lastRedemptionId == id;
      allow update, delete: if false;
    }

    // Caja privada: mismo acceso autenticado que el panel administrativo.
    function isCashAdmin() {
      return request.auth != null;
    }

    function cashAmount(value) {
      return value is int && value >= 0 && value <= 1000000000000;
    }

    function validSale(d) {
      return d.keys().hasAll(['date', 'customer', 'phone', 'channel', 'paymentMethod', 'status', 'items', 'discount', 'deliveryCharged', 'deliveryActual', 'otherCosts', 'collected', 'notes', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['date', 'customer', 'phone', 'channel', 'paymentMethod', 'status', 'items', 'discount', 'deliveryCharged', 'deliveryActual', 'otherCosts', 'collected', 'notes', 'createdAt', 'updatedAt', 'sourceOrderId', 'sourceOrderCode'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.customer is string && d.customer.size() <= 120
        && d.phone is string && d.phone.size() <= 40
        && d.notes is string && d.notes.size() <= 2000
        && d.channel in ['Mostrador', 'WhatsApp', 'Instagram', 'Web', 'Mayorista', 'Otro']
        && d.paymentMethod in ['Efectivo', 'Transferencia', 'QR', 'Tarjeta', 'Otro']
        && d.status in ['pagada', 'pendiente', 'anulada']
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && cashAmount(d.discount) && cashAmount(d.deliveryCharged) && cashAmount(d.deliveryActual)
        && cashAmount(d.otherCosts) && cashAmount(d.collected)
        && d.createdAt is timestamp && d.updatedAt == request.time
        && (!('sourceOrderId' in d) || (d.sourceOrderId is string && d.sourceOrderId.size() <= 128))
        && (!('sourceOrderCode' in d) || (d.sourceOrderCode is string && d.sourceOrderCode.size() <= 80));
    }

    function validExpense(d) {
      return d.keys().hasAll(['date', 'type', 'category', 'description', 'payee', 'amount', 'paymentMethod', 'status', 'notes', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['date', 'type', 'category', 'description', 'payee', 'amount', 'paymentMethod', 'status', 'notes', 'createdAt', 'updatedAt'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.type in ['Operativo', 'Mercadería', 'Inversión', 'Retiro']
        && d.category is string && d.category.size() > 0 && d.category.size() <= 100
        && d.description is string && d.description.size() > 0 && d.description.size() <= 300
        && d.payee is string && d.payee.size() <= 120
        && d.notes is string && d.notes.size() <= 2000
        && cashAmount(d.amount) && d.amount > 0
        && d.paymentMethod in ['Efectivo', 'Transferencia', 'QR', 'Tarjeta', 'Otro']
        && d.status in ['pagado', 'pendiente', 'anulado']
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }

    // Copia de preparación del historial: privada y separada de los movimientos.
    match /erpImports/{id} {
      allow read: if isCashAdmin();
      allow create, update: if isCashAdmin() && id == 'aura-caja'
        && request.resource.data.keys().hasOnly(['contents', 'updatedAt'])
        && request.resource.data.contents is string && request.resource.data.contents.size() <= 800000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /sales/{id} {
      allow read: if isCashAdmin();
      allow create: if isCashAdmin() && validSale(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if isCashAdmin() && validSale(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('sourceOrderId', '') == resource.data.get('sourceOrderId', '')
        && request.resource.data.get('sourceOrderCode', '') == resource.data.get('sourceOrderCode', '');
      // Se anulan los movimientos para conservar su historial.
      allow delete: if false;
    }

    match /expenses/{id} {
      allow read: if isCashAdmin();
      allow create: if isCashAdmin() && validExpense(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if isCashAdmin() && validExpense(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /salesConfig/{id} {
      allow read: if isCashAdmin();
      allow create, update: if isCashAdmin() && id == 'costs'
        && request.resource.data.keys().hasOnly(['costs', 'recipe', 'updatedAt'])
        && request.resource.data.costs is map
        && request.resource.data.costs.keys().hasOnly(['10 ML', '30 ML', '50 ML'])
        && cashAmount(request.resource.data.costs['10 ML'])
        && cashAmount(request.resource.data.costs['30 ML'])
        && cashAmount(request.resource.data.costs['50 ML'])
        && request.resource.data.updatedAt == request.time;
    }

    // Catálogo: lectura pública, escritura solo admin autenticado.
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Configuración del sitio: lectura pública, escritura solo admin.
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Pedidos de la tienda.
    // - create: público (el cliente confirma su compra sin estar logueado),
    //   pero validado para evitar basura: campos obligatorios, importes
    //   numéricos y estado inicial forzado a "pendiente".
    // - read/update/delete: solo el admin autenticado.
    match /orders/{id} {
      allow read, update, delete: if request.auth != null;
      allow create: if
        request.resource.data.status == 'pendiente'
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 3
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 40
        && request.resource.data.address is string
        && request.resource.data.address.size() < 400
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50;
    }

    // Alertas: compras que no se pudieron completar (ver src/lib/incidentsService.ts).
    // - create: público y validado (el cliente no está logueado; Äura no tiene
    //   usuario de servicio, así que escribe el navegador). Nace sin revisar.
    // - read: solo admin. update: solo marcar revisada. delete: admin.
    match /incidents/{id} {
      allow get, list: if request.auth != null;
      allow create: if
        request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt is int
        && request.resource.data.seen == false
        && (!('detail' in request.resource.data) || (request.resource.data.detail is string && request.resource.data.detail.size() <= 2000))
        && (!('customerPhone' in request.resource.data) || (request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() <= 40))
        && (!('customerName' in request.resource.data) || (request.resource.data.customerName is string && request.resource.data.customerName.size() <= 120))
        && (!('userAgent' in request.resource.data) || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300));
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt']);
      allow delete: if request.auth != null;
    }

    // Reseñas de clientes.
    // - create: público, queda pendiente (approved=false) con campos validados.
    // - read: cualquiera lee las aprobadas; el admin lee todas.
    // - update/delete (aprobar, ocultar, borrar): solo admin.
    match /reviews/{id} {
      allow get, list: if resource.data.approved == true || request.auth != null;
      allow create: if request.auth != null || (
        request.resource.data.approved == false
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 40
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 600
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt is int
      );
      allow update, delete: if request.auth != null;
    }
  }
}
