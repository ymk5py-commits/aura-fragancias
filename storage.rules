rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Imágenes de producto y banners: lectura pública, escritura solo admin.
    match /products/{file=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comprobantes de transferencia subidos por el cliente en el checkout.
    // - create: público pero acotado (solo imagen o PDF, hasta 5 MB) para
    //   que un cliente sin cuenta pueda adjuntar su comprobante.
    // - update/delete: solo el admin, así nadie puede pisar un comprobante.
    // - read: la URL de descarga de Firebase lleva un token aleatorio
    //   imposible de adivinar, y así el vendedor puede abrirla desde el
    //   link de WhatsApp sin estar logueado en el panel.
    match /comprobantes/{file} {
      allow read: if true;
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');
      allow update, delete: if request.auth != null;
    }
  }
}
